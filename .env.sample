# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ALLOWED_USERS=123456789,987654321  # comma-separated user IDs; leave empty to allow all

# Ghostfolio
GHOSTFOLIO_URL=http://localhost:3333
GHOSTFOLIO_ACCESS_TOKEN=your-ghostfolio-access-token
GHOSTFOLIO_ACCOUNT_ID=your-account-uuid

# IBKR Flex Web Service (required only for /sync_ibkr)
# Client Portal → Performance & Reports → Flex Queries
#IBKR_FLEX_TOKEN=your-flex-web-service-token
#IBKR_FLEX_QUERY_ID=your-trades-flex-query-id
#IBKR_TRADE_CONFIRMATION_QUERY_ID=your-today-trade-confirmation-query-id
#IBKR_CASH_QUERY_ID=your-cash-report-query-id
IBKR_FLEX_LOOKBACK_DAYS=365
# Destination account name used when no explicit UUID is configured
IBKR_GHOSTFOLIO_ACCOUNT_NAME=Interactive Brokers
# Optional: explicit destination UUID; takes precedence over the account name
#IBKR_GHOSTFOLIO_ACCOUNT_ID=your-ibkr-account-uuid

# Import mode: "direct" = POST activities straight to Ghostfolio
#              "json"   = generate a JSON file you can import manually via the Ghostfolio UI/API
IMPORT_MODE=json

# ── Backup ────────────────────────────────────────────────────────────────────
#
# BACKUP_STORAGE controls where backups are sent:
#   telegram  → bot sends you the file in this chat (default, no extra setup)
#   local     → saved on the server in BACKUP_LOCAL_DIR (mount as Docker volume)
#
BACKUP_STORAGE=telegram
BACKUP_LOCAL_DIR=backups

# Optional: run backups automatically. Leave commented out to disable.
# Accepted values: daily | weekly | monthly | quarterly
#BACKUP_SCHEDULE=monthly

# Optional: encrypt backups before saving/sending.
# Generate a key by running:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key safe — without it you cannot decrypt your backups.
#BACKUP_ENCRYPTION_KEY=your-fernet-key-here

# Logging
LOG_LEVEL=INFO
